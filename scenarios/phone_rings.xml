<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- A phone that rings and is then cancelled by the caller: it has to see the CANCEL,
     confirm it and refuse the INVITE with 487. A CANCEL carries the INVITE's CSeq number
     and branch, which is why the answers can be built from the last message. -->
<scenario name="Phone that rings until the caller gives up">
  <recv request="INVITE" timeout="20000"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <recv request="CANCEL" timeout="15000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 487 Request Terminated
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      CSeq: [last_cseq_number] INVITE
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <recv request="ACK"/>
</scenario>
