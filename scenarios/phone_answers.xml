<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- A phone, played by SIPp, waiting at its own port (the runner registers it with register_ok
     and -key contact_port). It rings, answers, echoes the audio it receives (run it with
     -rtp_echo) and waits for the caller to hang up. -->
<scenario name="Phone that answers">
  <recv request="INVITE" timeout="20000"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="300"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=[user] 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
    ]]>
  </send>

  <recv request="ACK"/>

  <recv request="BYE" timeout="15000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[user]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>
</scenario>
